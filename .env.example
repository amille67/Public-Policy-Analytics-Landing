# .env.example — copy to .env and fill in values
# Never commit .env to version control (it is git-ignored)

# ---------------------------------------------------------------------------
# Census Bureau API Key
# Obtain free key at: https://api.census.gov/data/key_signup.html
# Required for national extension notebooks; optional for cached local runs.
# ---------------------------------------------------------------------------
CENSUS_API_KEY=

# ---------------------------------------------------------------------------
# Data paths
# ---------------------------------------------------------------------------
# Root directory for raw data files (default: data/raw/DATA)
PPA_DATA_ROOT=data/raw/DATA

# Root directory for chapter outputs (default: outputs)
PPA_OUTPUT_ROOT=outputs

# Disk cache directory for joblib-cached API responses (default: ~/.cache/ppa)
PPA_CACHE_DIR=~/.cache/ppa

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Global random seed for reproducibility (default: 42)
PPA_SEED=42

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
PPA_LOG_LEVEL=INFO
